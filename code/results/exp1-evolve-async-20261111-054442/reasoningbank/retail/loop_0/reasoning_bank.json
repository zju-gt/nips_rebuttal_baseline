      "id": "exchange_modify:c3fe839efb73",
      "content_hash": "c3fe839efb73",
      "title": "When an exchange request has conditional logic, verify.",
      "lesson": "When an exchange request has conditional logic, verify SKU/variant availability first, then restate the exact item IDs and get explicit confirmation before submitting the exchange and payment method for any price difference.",
      "applicability": "when handling similar exchange_modify cases",
      "family": "exchange_modify",
      "outcome_type": "success",
